# ============================================================
# Kavach — F&O Risk & Position-Sizing Engine
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Angel One SmartAPI credentials ---
ANGELONE_CLIENT_CODE=your_client_code
ANGELONE_PASSWORD=your_password
ANGELONE_TOTP_SECRET=your_totp_secret_alphanumeric
ANGELONE_API_KEY=your_api_key

# --- Database ---
# Format for Supabase Session Pooler (IPv4-compatible, required for Render):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://kavach:kavach@db:5432/kavach

# --- Redis (not needed if running single-process FastAPI mode) ---
REDIS_URL=redis://redis:6379/0

# --- Risk engine defaults (overridden via Settings page in dashboard) ---
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_CONCENTRATION_PCT=20.0
MAX_MARGIN_UTILISATION_PCT=70.0
KELLY_FRACTION_MULTIPLIER=0.3
ORDER_VELOCITY_LIMIT_PER_10MIN=5
EXPIRY_DAY_SIZE_DAMPENER=0.5

# --- App ---
ENV=development
SECRET_KEY=change-me-in-production
# Set to True to run risk engine without placing real orders.
# Orders are logged to paper_orders DB table instead.
PAPER_MODE=True

# --- Telegram alerting (optional) ---
# Leave empty to disable. Kavach will skip alerts silently.
# Setup: create a bot via @BotFather, add to a group, get the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
